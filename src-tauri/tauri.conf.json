{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Beez Desktop Two",
  "version": "0.1.16",
  "identifier": "io.beez.desktop",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Beez Desktop Two v0.1.16",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "licenseFile": "LICENSE",
    "publisher": "Enrico Zanardo",
    "copyright": "Copyright (c) 2026 Enrico Zanardo. GNU Affero General Public License v3.",
    "resources": [
      "../sidecar",
      "../shared",
      "../LICENSE"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
